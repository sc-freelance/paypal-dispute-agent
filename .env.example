# Copy this file to .env and fill in your own values.
# .env is ignored by git, so your real keys never reach GitHub.
# This file is committed: it lists the names of the settings, never real values.

# ---- PayPal (sandbox only) ----
# From developer.paypal.com > Apps & Credentials, with the Sandbox toggle on.
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# The sandbox personal account that plays the client (invoices are sent to it).
PAYPAL_SANDBOX_CLIENT_EMAIL=client-sandbox-email@personal.example.com

# ---- Anthropic (the AI agent) ----
ANTHROPIC_API_KEY=your-anthropic-api-key
# claude-haiku-5-5 while building (cheaper); claude-sonnet-5-5 for the final demo.
ANTHROPIC_MODEL=claude-haiku-5-5

# ---- Django ----
# Any long random string. Generate one with:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Demo ----
# True on the hosted site: shows the Demo mode banner and the Reset demo button.
DEMO_MODE=False
